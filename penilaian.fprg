<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 12:46:50 PM"/>
        <attribute name="created" value="QVNVUztMQVBUT1AtMExBTjhGN0k7MjAyNi0wOS0yMzsxMjo0MTozMyBQTTsyNjI4"/>
        <attribute name="edited" value="QVNVUztMQVBUT1AtMExBTjhGN0k7MjAyNi0wOS0yMzsxMjo0Njo1MCBQTTsxOzI3NDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nilai" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan nilai angka (0-100)&quot;" newline="True"/>
            <input variable="nilai"/>
            <if expression="nilai&gt;=85">
                <then>
                    <output expression="&quot;A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="nilai&gt;=70 &amp;&amp; nilai&lt;=84">
                        <then>
                            <output expression="&quot;B&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="nilai&gt;=55 &amp;&amp; nilai&lt;=69">
                                <then>
                                    <output expression="&quot;C&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="nilai&gt;=40 &amp;&amp; nilai&lt;=54">
                                        <then>
                                            <output expression="&quot;D&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;E&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
